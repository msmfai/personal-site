{% comment %}
  Timeline component for displaying chronological history
  Uses entries from _data/timeline.yml
{% endcomment %}

{% assign timeline_limit = include.limit %}
{% assign timeline_scrollable = page.timeline.scrollable %}

<div class="timeline {% if timeline_scrollable %}scrollable{% endif %}">
  {% if site.data.timeline %}
    {% for entry in site.data.timeline limit: timeline_limit %}
      <div class="timeline-item">
        {% if entry.icon %}
          <div class="timeline-marker timeline-marker-icon">
            <img src="{{ entry.icon | relative_url }}" alt="" />
          </div>
        {% elsif entry.emoji %}
          <div class="timeline-marker timeline-marker-emoji">{{ entry.emoji }}</div>
        {% else %}
          <div class="timeline-marker"></div>
        {% endif %}
        <div class="timeline-content">
          <div class="timeline-date">{{ entry.date }}</div>
          <div class="timeline-text">{{ entry.content | markdownify }}</div>
        </div>
      </div>
    {% endfor %}
  {% else %}
    <p class="font-italic">No timeline entries found.</p>
  {% endif %}
</div>

<style>
  .timeline {
    position: relative;
    padding-left: 2rem;
    margin-top: 1rem;
  }

  .timeline.scrollable {
    max-height: 400px;
    overflow-y: auto;
    padding-right: 1rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0.5rem;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--global-divider-color);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .timeline-marker {
    position: absolute;
    left: -1.5rem;
    top: 0.25rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--global-theme-color);
    border: 2px solid var(--global-bg-color);
    z-index: 1;
  }

  .timeline-marker-icon {
    width: 24px;
    height: 24px;
    left: -2rem;
    top: 0;
    border-radius: 4px;
    background: var(--global-bg-color);
    border: 1px solid var(--global-divider-color);
    padding: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .timeline-marker-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .timeline-marker-emoji {
    width: 24px;
    height: 24px;
    left: -2rem;
    top: 0;
    border-radius: 50%;
    background: var(--global-bg-color);
    border: 2px solid var(--global-divider-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
  }

  .timeline-date {
    font-weight: bold;
    color: var(--global-theme-color);
    margin-bottom: 0.25rem;
    font-size: 0.9rem;
  }

  .timeline-text {
    color: var(--global-text-color);
    line-height: 1.5;
  }

  .timeline-text p {
    margin-bottom: 0.5rem;
  }

  .timeline-text p:last-child {
    margin-bottom: 0;
  }
</style>
