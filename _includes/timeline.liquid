{% comment %}
  Timeline component for displaying chronological history
  Uses entries from _data/timeline.yml
{% endcomment %}

{% assign timeline_limit = include.limit %}
{% assign timeline_scrollable = page.timeline.scrollable %}

<div class="timeline {% if timeline_scrollable %}scrollable{% endif %}">
  {% if site.data.timeline %}
    {% assign sorted_timeline = site.data.timeline | sort: 'date' | reverse %}
    {% for entry in sorted_timeline limit: timeline_limit %}
      <div class="timeline-item">
        <div class="timeline-marker"></div>
        <div class="timeline-content">
          <div class="timeline-date">{{ entry.date }}</div>
          <div class="timeline-text">{{ entry.content | markdownify }}</div>
        </div>
      </div>
    {% endfor %}
  {% else %}
    <p class="font-italic">No timeline entries found.</p>
  {% endif %}
</div>

<style>
  .timeline {
    position: relative;
    padding-left: 2rem;
    margin-top: 1rem;
  }

  .timeline.scrollable {
    max-height: 400px;
    overflow-y: auto;
    padding-right: 1rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0.5rem;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--global-divider-color);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .timeline-marker {
    position: absolute;
    left: -1.5rem;
    top: 0.25rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--global-theme-color);
    border: 2px solid var(--global-bg-color);
    z-index: 1;
  }

  .timeline-date {
    font-weight: bold;
    color: var(--global-theme-color);
    margin-bottom: 0.25rem;
    font-size: 0.9rem;
  }

  .timeline-text {
    color: var(--global-text-color);
    line-height: 1.5;
  }

  .timeline-text p {
    margin-bottom: 0.5rem;
  }

  .timeline-text p:last-child {
    margin-bottom: 0;
  }
</style>
